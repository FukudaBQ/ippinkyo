<script src="/js/main.js?1758683600"></script>
<script>
$(function(){
	const applyMenuHtml = function(ln) {
		const lang = ln.replace(/\//g, '') || 'ja';
		
		// 商品説明（詳細）の切り替え
		$('[class*="of-desc-"]').hide();
		const $descs = $('.of-desc-' + lang);
		if ($descs.length > 0) {
			$descs.show();
		} else {
			$('.of-desc-ja').show();
		}
		
		// キャッチフレーズ（タイトル置換）の切り替え
		$('[class*="of-catch-"]').hide();
		// 元のメニュー名と改行のリセット
		$('.of-menu-name, .of-menu-br').show();
		
		const $catches = $('.of-catch-' + lang);
		if ($catches.length > 0) {
			$catches.show().each(function(){
				// キャッチフレーズがある場合は元の名前を隠す
				$(this).closest('li, .modal-main').find('.of-menu-name, .of-menu-br').not('.not-hide').hide();
			});
		} else if (lang !== 'ja') {
			// 指定言語のキャッチフレーズがない場合、日本語用があればそれを表示してタイトルを隠す（GTranslateの翻訳対象にする）
			$('.of-catch-ja').show().each(function(){
				$(this).closest('li, .modal-main').find('.of-menu-name, .of-menu-br').not('.not-hide').hide();
			});
		}
	};

	$(document).on('touchstart click', '.gtranslate_wrapper a', function(){
		let ln = $(this).attr('data-gt-lang');
		ln = ln == 'ja' ? '' : ('/' + ln);
		history.pushState(null, null, location.href.replace(/osaka\-yataimura\.com\/(ja|zh\-CN|zh\-TW|en|ko)?/, 'osaka-yataimura.com' + ln));
		$('a').each(function(){
			if (!$(this).attr('data-lightbox') && $(this).attr('href') && $(this).attr('href').match(/^\//)) $(this).attr('href', $(this).attr('href').replace(/^\/(ja|zh\-CN|zh\-TW|en|ko)?\/?/, ln + '/'));
		});
		if ($('.of-1-go').length) {
			$('.of-1-go').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('1合');
				} else {
					$(this).text('(180ml)');
				}
			});
		}
		if ($('.of-1-ko').length) {
			$('.of-1-ko').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('1個');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('一个');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('한개');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text(' One piece ');
				}
			});
		}
		if ($('.of-3-ko').length) {
			$('.of-3-ko').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('3個');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('三个');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('삼개');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text(' Three pieces ');
				}
			});
		}
		if ($('.of-1-hon').length) {
			$('.of-1-hon').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('1本');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('一本');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('한병');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text(' One ');
				}
			});
		}
		if ($('.of-2-hon').length) {
			$('.of-2-hon').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('2本');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('二本');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('이병');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text(' Two ');
				}
			});
		}
		if ($('.of-3-hon').length) {
			$('.of-3-hon').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('3本');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('三本');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('삼병');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text(' Three ');
				}
			});
		}
		if ($('.of-5-hon').length) {
			$('.of-5-hon').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('5本');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('五本');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('오병');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text(' Five ');
				}
			});
		}
		if ($('.of-1-sara').length) {
			$('.of-1-sara').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('1皿');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('(一盘)');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('(한접시)');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text('(One plate)');
				}
			});
		}
		if ($('.of-1-hai').length) {
			$('.of-1-hai').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('1杯');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('(一杯)');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('(한잔)');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text('(serving)');
				}
			});
		}
		if ($('.of-drink').length) {
			$('.of-drink').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('飲み物');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('饮料');
				} else if (ln == '/zh-TW' || ln == '/zh-TW/') {
					$(this).text('飲料');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('음료');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text('Drinks & Bar');
				}
			});
		}
		if ($('.of-event').length) {
			$('.of-event').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('イベント');
				} else if (ln == '/zh-CN' || ln == '/zh-CN/') {
					$(this).text('活动');
				} else if (ln == '/zh-TW' || ln == '/zh-TW/') {
					$(this).text('活動');
				} else if (ln == '/ko' || ln == '/ko/') {
					$(this).text('이벤트');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text('Entertainment');
				}
			});
		}
		if ($('.of-access').length) {
			$('.of-access').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('アクセス');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text('Location & Directions');
				}
			});
		}
		if ($('.of-global').length) {
			$('.of-global').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('多言語対応');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text('Global Guests Welcome');
				}
			});
		}
		if ($('.of-walk').length) {
			$('.of-walk').each(function(){
				if (ln == '' || ln == '/') {
					$(this).html($(this).html().replace('A 5-minute walk', '徒歩5分'));
				} else if (ln == '/en' || ln == '/en/') {
					$(this).html($(this).html().replace('徒歩5分', 'A 5-minute walk'));
				}
			});
		}
		if ($('.of-cta-footer').length) {
			$('.of-cta-footer').each(function(){
				if (ln == '' || ln == '/') {
					$(this).text('道頓堀の中心で、お祭りの提灯を目印にしてください！予約不要。そのまま入ってお祭りに参加しよう！');
				} else if (ln == '/en' || ln == '/en/') {
					$(this).text('Find us in the heart of Dotonbori – just look for the festival lights! No reservation needed. Walk in and join the party!');
				}
			});
		}
		
		// 新しい汎用タグの適用
		applyMenuHtml(ln == 'ja' ? '' : ln);
	});
	
	// 初期読み込み時の適用
	applyMenuHtml('');
});
</script>




</body>
</html>
