        <section class="review" id="review">
<script>
const API_KEY = 'AIzaSyDlBkIxVmbr4B7BsnHzSbaX8w0RUZozr_U';
$.getScript('https://maps.google.com/maps/api/js?key=' + API_KEY + '&libraries=places', function(){
	const service = new google.maps.places.PlacesService(document.createElement('div'));

	// 全レビュー格納所
	const allReview = [];
	// 全レビュー出力場所
	const $review_all = $('#js_review_all');
	service.getDetails({
		placeId: 'ChIJecz3Q9_nAGARI7mAudEEvJw',
		fields: ['review'],
		language: 'ja'
	}, function(place, status) {
		if (status == google.maps.places.PlacesServiceStatus.OK) {
			$.each(place.reviews, function(){
				// レビューの氏名・レート・内容を取得し格納
				const reviewObj = {};
				reviewObj['name'] = this.author_name;
				reviewObj['rate'] = this.rating;
				reviewObj['content'] = this.text;
				reviewObj['url'] = this.author_url;
				reviewObj['image'] = this.profile_photo_url;
				reviewObj['date'] = this.relative_time_description;
				reviewObj['time'] = this.time;
				// 全レビュー格納所へin
				allReview.push(reviewObj);
			});
			allReview.sort((a, b) => {
			if (a.time < b.time) {
				return 1;
			} else if (b.time < a.time) {
				return -1;
			}
			return 0;
			});
		}
		// 全クチコミを回す
		let cnt = 0;
		for (const key in allReview) {
			let star;
			let $append = '<li class="rv_main"><div class="rv_hd flex"><img src="' + allReview[key].image + '" alt="' + allReview[key].name + '">';
			$append += '<h3 class="column">' + allReview[key].name + '<small>' + allReview[key].date + '</small></h3></div>';
			$append += '<div class="star flex">';
			for (let star = 1; star <= allReview[key].rate; star++) {
				$append += '<img src="/img/rv_star.png">';
			}
			$append += '</div><p>' + allReview[key].content.substring(0, 135) + '...</p></li>';
			// 全クチコミ用格納dlにどんどん追加する
			$review_all.append($append);
		}
    $('.rv_slide').slick({
      infinite: true,
      slidesToShow: 7,
      slidesToScroll: 1,
      arrows: true,
      dots: false,
      fade: false,
      centerMode: false,
      prevArrow: '<button type="button" class="slick-prev" aria-label="Previous"></button>',
      nextArrow: '<button type="button" class="slick-next" aria-label="Next"></button>',
      responsive: [
        {
          breakpoint: 1731,
          settings: {
            slidesToShow: 6,
          },
        },
        {
          breakpoint: 1441,
          settings: {
            slidesToShow: 5,
          },
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1,
            centerMode: false,
          },
        },
      ],
    });
	});
});
</script>
            <h2 class="ac">お客様の声</h2>
            <ul class="rv_slide" id="js_review_all"></ul>
            <a href="/review" class="more_btn_w flex auto">詳細はこちら</a>
        </section>
    </main>




