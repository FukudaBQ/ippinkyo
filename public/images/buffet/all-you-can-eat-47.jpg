<style>
/* モーダルと背景の指定 */
.cl-modal{
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  text-align: center;
  background: rgba(0,0,0,50%);
  padding: 40px 20px;
  overflow: auto;
  opacity: 0;
  visibility: hidden;
  transition: .3s;
  box-sizing: border-box;
	z-index: 1;
}

/* モーダルの擬似要素の指定 */
.cl-modal:before{
  content: "";
  display: inline-block;
  vertical-align: middle;
  height: 100%;
  margin-left: -0.2em;
}

/* クラスが追加された時の指定 */
.cl-modal.is-active{
  opacity: 1;
  visibility: visible;
 display:block;
z-index:10;
}

/* モーダル内側の指定 */
.cl-modal-container{
  position: relative;
  display: inline-block;
  vertical-align: middle;
  max-width: 600px;
  width: 96%;
}

/* モーダルを閉じるボタンの指定 */
.cl-modal-close{
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  top: -20px;
  right: -20px;
  width: 40px;
  height: 40px;
  color: #fff;
  background: #000;
  border-radius: 50%;
  cursor: pointer;
}

/* モーダルのコンテンツ部分の指定 */
.cl-modal-content{
  background: #fff;
  text-align: left;
  line-height: 1.8;
  padding: 20px;
}

/* モーダルのコンテンツ部分のテキストの指定 */
.cl-modal-content h3{
	font-size:24px;
  margin: 1em 0;
}
.cl-modal-content p{
	font-size:16px;
  margin: 1em 0;
}
@media (max-width: 800px) {
.cl-modal{
padding-top:200px;
}
}
.fc-h-event .fc-event-title {
cursor:pointer;
text-overflow:ellipsis;
}
</style>
<script src="/js/index.global.min.js?20260309"></script>
<script src="/js/locales-all.global.min.js"></script>
<script>
// カレンダー
document.addEventListener('DOMContentLoaded', function () {
  const calendarEl = document.getElementById('calendar');
  const headerWrapper = document.getElementById('calendar-header'); // wrapper全体
  const headerCenterEl = document.createElement('div');
  headerCenterEl.id = 'calendar-header-center';

  // ヘッダーの初期構築（1回だけ）
  headerWrapper.innerHTML = `
    <div class="custom-header-wrapper flex">
      <button class="nav global-prev"></button>
    </div>
  `;
  headerWrapper.querySelector('.custom-header-wrapper').appendChild(headerCenterEl);
  headerWrapper.querySelector('.custom-header-wrapper').insertAdjacentHTML('beforeend', `
    <button class="nav global-next"></button>
  `);

  // 中央部分（年・月表示 + 年月切替ボタン）のDOM構築（初回のみ）
  const headerInner = document.createElement('div');
  headerInner.className = 'custom-header-inner flex';
  headerInner.innerHTML = `
    <span class="year"></span>
    <div class="switchs column">
      <button class="nav prev-year"></button>
      <button class="nav next-year"></button>
    </div>

    <span class="month"></span>
    <div class="switchs column">
      <button class="nav prev-month"></button>
      <button class="nav next-month"></button>
    </div>
  `;
  headerCenterEl.appendChild(headerInner);

  // カレンダー生成
  const calendar = new FullCalendar.Calendar(calendarEl, {
    initialView: 'dayGridMonth',
    locale: 'ja',
    headerToolbar: false,
    fixedWeekCount: true,
    contentHeight: 'auto',
		events: {
				url: '/main/get_news?ln=ja',
		},

		eventDidMount: function(info) {
//			console.log(info.event.title);
			info.el.onclick=function(){
				document.querySelector('.cl-modal-content h3').textContent = info.event.title;
				document.querySelector('.cl-modal-content div.inner-contents').innerHTML = info.event.extendedProps.description;
				modalOpen();
			};
		},
    dayCellContent: function(arg) {
      return arg.date.getDate(); // → 数字だけ（1, 2, 3, ...）
    },

    datesSet(info) {
      updateCalendarHeader(info); // テキスト更新だけ
    }
  });

  // 年・月テキスト更新関数
  function updateCalendarHeader(info) {
    const date = new Date(info.view.currentStart);
    const year = date.getFullYear();
    const month = date.getMonth() + 1;

    headerInner.querySelector('.year').textContent = `${year}年`;
    headerInner.querySelector('.month').textContent = `${month}月`;
  }

  // ボタンイベント登録（最初に一度だけ）
  headerInner.querySelector('.prev-year').onclick = () => calendar.prevYear();
  headerInner.querySelector('.next-year').onclick = () => calendar.nextYear();
  headerInner.querySelector('.prev-month').onclick = () => calendar.prev();
  headerInner.querySelector('.next-month').onclick = () => calendar.next();
  headerWrapper.querySelector('.global-prev').onclick = () => calendar.prev();
  headerWrapper.querySelector('.global-next').onclick = () => calendar.next();

  // レンダリング
  calendar.render();
});
let modal, close;
//「開くボタン」をクリックしてモーダルを開く
function modalOpen() {
  modal.classList.add('is-active');
}
//「閉じるボタン」をクリックしてモーダルを閉じる
function modalClose() {
  modal.classList.remove('is-active');
}
function modalOut(e) {
	if (e.target == modal) {
		modal.classList.remove('is-active');
	}
}
document.addEventListener("DOMContentLoaded", function(){
	modal = document.querySelector('.js-modal'),
				close = document.querySelector('.js-modal-close');

			console.log(modal.classList);
	close.addEventListener('click', modalClose);

	//「モーダルの外側」をクリックしてモーダルを閉じる
	addEventListener('click', modalOut);
});
</script>
